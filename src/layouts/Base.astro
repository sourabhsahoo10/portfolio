---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

const { title, description = 'Sourabh Sahoo — senior product + AI engineer.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'home', key: 'h' },
  { href: '/blog/research', label: 'blog', key: 'b', match: '/blog' },
  { href: '/work', label: 'work', key: 'w' },
  { href: '/projects', label: 'projects', key: 'p' },
  { href: '/sourabh-sahoo-resume.pdf', label: 'resume', key: 'r' },
];

const isCurrent = (l) => (l.match ? path.startsWith(l.match) : path === l.href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | Sourabh Sahoo` : 'Sourabh Sahoo'}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <div class="wrap">
      <nav class="top">
        {links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l) ? 'page' : undefined}>
            <span class="key">[{l.key}]</span> {l.label}
          </a>
        ))}
      </nav>

      <main>
        <slot />
      </main>

      <footer class="elsewhere">
        <a href="https://github.com/sourabhsahoo10">github</a>
        <a href="https://www.linkedin.com/in/sourabhsahoo/">linkedin</a>
      </footer>
    </div>

    <script is:inline define:vars={{ links }}>
      const map = Object.fromEntries(links.map((l) => [l.key, l.href]));

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;
        const href = map[e.key.toLowerCase()];
        if (href) window.location.href = href;
      });
    </script>
  </body>
</html>
