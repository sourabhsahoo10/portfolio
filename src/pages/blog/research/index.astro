---
import Base from '../../../layouts/Base.astro';
import BlogNav from '../../../components/BlogNav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date - a.data.date
);

const fmt = (d) =>
  d.toLocaleDateString('en-US', { month: 'short', year: '2-digit' }).toLowerCase();
---

<Base title="research" description="Finished writing.">
  <BlogNav />

  {posts.length === 0 && <p class="muted">nothing published yet.</p>}

  {posts.map((p) => (
    <div class="row">
      <a href={`/blog/research/${p.id}`}>{p.data.title}</a>
      <span class="date">{fmt(p.data.date)}</span>
    </div>
  ))}
</Base>
