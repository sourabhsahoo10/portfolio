---
import Base from '../../../layouts/Base.astro';
import BlogNav from '../../../components/BlogNav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date - a.data.date
);

const fmt = (d) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
---

<Base title="Research" description="Writing by Sourabh Sahoo.">
  <header class="intro">
    <h1><span class="star">*</span>research</h1>
    <BlogNav />
  </header>

  <section>
    {posts.length === 0 && <div class="faint">nothing published yet.</div>}
    {posts.map((p) => (
      <div class="row">
        <a class="item-title" href={`/blog/research/${p.id}`}>{p.data.title}</a>
        <span class="date">{fmt(p.data.date)}</span>
      </div>
    ))}
  </section>
</Base>
