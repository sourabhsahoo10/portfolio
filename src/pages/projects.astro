---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const projects = [
  {
    name: 'llm memory',
    note: 'a model-agnostic memory layer for llms — what to retain, retrieve and expire over long horizons.',
    href: null,
  },
  { name: 'kv cache', note: null, href: null },
];
---

<Base title="Projects" description="Things Sourabh Sahoo is building.">
  <header class="intro">
    <h1><span class="star">*</span>projects</h1>
  </header>

  {projects.map((p) => (
    <Section title={p.name}>
      {p.note && <div class="muted">{p.note}</div>}
      <div class="row">
        {p.href ? <a class="accent" href={p.href}>source ↗</a> : <span class="faint">wip</span>}
      </div>
    </Section>
  ))}
</Base>
