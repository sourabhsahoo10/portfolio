---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 3);

const fmt = (d) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
---

<Base>
  <header class="intro">
    <h1>sourabh sahoo</h1>
    <p class="muted">
      senior product + ai engineer at <span class="accent">macrox</span>.
    </p>
    <p class="muted">
      i like exploring the frontier of technology, experimenting with new tools,
      and building my own versions of things.
    </p>
  </header>

  <Section title="blog">
    {posts.map((p) => (
      <div class="row">
        <a class="item-title" href={`/blog/research/${p.id}`}>{p.data.title}</a>
        <span class="date">{fmt(p.data.date)}</span>
      </div>
    ))}
  </Section>

  <Section title="currently">
    <div class="row">
      <span><span class="muted">building</span> <span class="item-title">llm memory</span></span>
    </div>
    <div class="row">
      <span><span class="muted">reading</span> <span class="faint">—</span></span>
    </div>
  </Section>

  <Section title="work">
    <div class="row">
      <span><span class="item-title">senior product engineer</span> <span class="muted">macrox</span></span>
      <span class="date">2025 —</span>
    </div>
    <div class="row">
      <span><span class="item-title">data scientist</span> <span class="muted">macrox</span></span>
      <span class="date">2023 — 2025</span>
    </div>
  </Section>

  <Section title="projects">
    <div class="row">
      <span class="item-title">llm memory</span>
      <span class="date">wip</span>
    </div>
    <div class="row">
      <span class="item-title">kv cache</span>
      <span class="date">wip</span>
    </div>
  </Section>
</Base>
