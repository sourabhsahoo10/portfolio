  <Section title="macrox">
    <div class="row">
      <span class="item-title">senior product engineer, ai/ml</span>
      <span class="date">2025 —</span>
    </div>
    <div class="muted">mcp servers, retrieval, fine-tuning, the api platform.</div>
    <div class="row">
      <span class="item-title">data scientist</span>
      <span class="date">2023 — 2025</span>
    </div>
    <div class="muted">alternative-data indicators and the pipelines under them.</div>
  </Section>

  <Section title="standard chartered">
    <div class="row">
      <span class="item-title">senior development architect</span>
      <span class="date">2018 — 2021</span>
    </div>
    <div class="muted">ml on credit-card data.</div>
  </Section>

  <Section title="before that">
    <div class="row">
      <span><span class="item-title">m.s. robotics</span> <span class="muted">ucsd</span></span>
      <span class="date">2021 — 2023</span>
